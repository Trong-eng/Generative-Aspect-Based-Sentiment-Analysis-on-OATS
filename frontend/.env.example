# Use the in-browser mock service (true) or the HTTP API (false). Defaults to true when unset.
VITE_USE_MOCK_API=true

# Base URL of the backend that serves POST /predict. Leave empty to call a relative `/predict`
# on the same origin (or through DEV_PROXY_TARGET during `npm run dev`).
VITE_API_BASE_URL=

# Client-side timeout for one /predict request, in milliseconds.
VITE_API_TIMEOUT_MS=30000

# Artificial latency for mock responses, in milliseconds.
VITE_MOCK_DELAY_MS=600

# Dev server only (not exposed to the browser): proxy `/predict` to this backend origin.
DEV_PROXY_TARGET=
